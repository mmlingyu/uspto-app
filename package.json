{
  "name": "uspto-trademark-zh",
  "private": true,
  "version": "1.0.0",
  "description": "中文界面的 USPTO 美国商标查询",
  "author": "商标查询",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "PORT=43124 tsx server/cli.ts",
    "dev:web": "vite --host 0.0.0.0 --port 43123 --strictPort",
    "check": "tsx scripts/self-check.ts",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --pretty false --noEmit",
    "build:web": "tsc -b --pretty false && vite build",
    "build:server": "esbuild server/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist-server/cli.js",
    "build:desktop": "esbuild electron/main.ts --bundle --platform=node --format=esm --target=node22 --external:electron --outfile=dist-electron/main.js",
    "build": "tsc -p tsconfig.server.json --pretty false --noEmit && npm run build:web && npm run build:server && npm run build:desktop",
    "start": "STATIC_DIR=dist PORT=43123 node dist-server/cli.js",
    "desktop": "npm run build && electron .",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "lint": "oxlint"
  },
  "build": {
    "appId": "local.trademark.uspto-zh",
    "productName": "商标查询",
    "executableName": "trademark-search",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "trademark-search-win-${version}-setup.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "商标查询",
      "uninstallDisplayName": "商标查询"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.business"
    },
    "asar": true
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.53.0",
    "radix-ui": "^1.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
